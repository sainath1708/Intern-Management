# ---------------------------------------------------------------------------
# Server environment configuration
# Copy this file to server/.env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qubenix?retryWrites=true&w=majority
# Required unless USE_IN_MEMORY_DB=true (local demo fallback only).
MONGODB_URI=

# Optional local demo fallback: starts a temporary in-memory MongoDB when
# MONGODB_URI is empty. Data is lost when the server stops. Never use in production.
USE_IN_MEMORY_DB=false

# Authentication
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=1d

# Comma separated list of allowed browser origins (no trailing slash).
# Add the deployed frontend URL in production, e.g. https://qubenix-interns.vercel.app
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Seed administrator (required by `npm run seed`)
ADMIN_NAME=Qubenix Admin
ADMIN_EMAIL=admin@qubenix.ai
ADMIN_PASSWORD=Admin@12345

# Seed demo interns (optional - defaults are documented in README.md)
SEED_INTERN_PASSWORD=Intern@12345

# Number of reverse proxies in front of the API (Render = 1)
TRUST_PROXY=1

# Optional: comma-separated DNS resolvers for networks whose default resolver
# refuses Atlas SRV lookups. Leave unset in production (e.g. Render).
# DNS_SERVERS=8.8.8.8,1.1.1.1
