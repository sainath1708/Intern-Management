# Base URL of the Express API (must include the /api prefix)
VITE_API_URL=http://localhost:5000/api

# Optional local demo shortcuts. Leave these blank in the committed example and
# in production so no credentials are bundled into the frontend JavaScript.
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_INTERN_EMAIL=
VITE_DEMO_INTERN_PASSWORD=
