# Root environment reference
#
# The application reads two separate files:
#   server/.env  -> backend configuration (see server/.env.example)
#   client/.env  -> frontend configuration (see client/.env.example)
#
# This file documents every variable used by the project. Copy the examples,
# never commit real secrets.

# ---- server/.env ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qubenix?retryWrites=true&w=majority
USE_IN_MEMORY_DB=false
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
ADMIN_NAME=Qubenix Admin
ADMIN_EMAIL=admin@qubenix.ai
ADMIN_PASSWORD=set-a-strong-admin-password
SEED_INTERN_PASSWORD=set-a-strong-intern-password
TRUST_PROXY=1

# ---- client/.env ----
VITE_API_URL=http://localhost:5000/api
